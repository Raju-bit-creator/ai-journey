NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_journey
REDIS_URL=redis://localhost:6380

# TypeORM auto-creates/updates tables from entities when this isn't "false".
# There's no migration system yet, so this stays on by default everywhere,
# including production containers. Set to "false" once real migrations exist.
DB_SYNCHRONIZE=true
